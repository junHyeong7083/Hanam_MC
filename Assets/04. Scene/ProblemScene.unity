--- !u!114 &303689702
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 303689698}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 73947b5a1568cdd45a4d393a5e14623d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  useDBSave: 0
  context: {fileID: 0}
  stepKeyConfig:
    stepId: 0
  steps:
  - id: 1
    title: "\uD3B8\uC548\uD55C \uC790\uC138"
    instruction: "\uAC10\uB3C5 \uC758\uC790\uC5D0 \uD3B8\uC548\uD788 \uC549\uC544\uC8FC\uC138\uC694.\r\n\uB4F1\uC744
      \uC758\uC790\uC5D0 \uAE30\uB300\uACE0, \uC5B4\uAE68\uC758 \uD798\uC744 \uBE7C\uC8FC\uC138\uC694."
    durationSeconds: 5
  - id: 2
    title: "\uB208 \uAC10\uAE30"
    instruction: "\uCC9C\uCC9C\uD788 \uB208\uC744 \uAC10\uC544\uC8FC\uC138\uC694.\r\n\uC8FC\uBCC0\uC758
      \uC18C\uB9AC\uC640 \uBE5B\uC744 \uCC28\uB2E8\uD558\uACE0,\r\n\uB0B4\uBA74\uC758
      \uD3C9\uD654\uC5D0 \uC9D1\uC911\uD574\uBD10\uC694."
    durationSeconds: 5
  - id: 3
    title: "\uBCF5\uC2DD \uD638\uD761 1"
    instruction: "\uCF54\uB85C \uCC9C\uCC9C\uD788 \uC228\uC744 \uB4E4\uC774\uB9C8\uC2DC\uC138\uC694.\r\n1...
      2... 3... 4...\r\n\uBC30\uAC00 \uBD80\uD480\uC5B4 \uC624\uB974\uB294 \uAC83\uC744
      \uB290\uAEF4\uBCF4\uC138\uC694."
    durationSeconds: 6
  - id: 4
    title: "\uBCF5\uC2DD \uD638\uD761 2"
    instruction: "\uC7A0\uC2DC \uC228\uC744 \uBA48\uCDB0\uC8FC\uC138\uC694.\r\n1...
      2..."
    durationSeconds: 4
  - id: 5
    title: "\uBCF5\uC2DD \uD638\uD761 3"
    instruction: "\uC785\uC73C\uB85C \uCC9C\uCC9C\uD788 \uC228\uC744 \uB0B4\uC26C\uC138\uC694.\r\n1...
      2... 3... 4... 5... 6...\r\n\uBAB8\uC758 \uAE34\uC7A5\uC774 \uD568\uAED8 \uBE60\uC838\uB098\uAC00\uC694."
    durationSeconds: 8
  - id: 6
    title: "\uADFC\uC721 \uC774\uC644 - \uC5BC\uAD74"
    instruction: "\uC774\uB9C8, \uB208 \uC8FC\uBCC0, \uC785 \uC8FC\uBCC0\uC758 \uAE34\uC7A5\uC744
      \uD480\uC5B4\uC8FC\uC138\uC694.\r\n\uD131\uC758 \uD798\uB3C4 \uBE7C\uC8FC\uC138\uC694."
    durationSeconds: 6
  - id: 7
    title: "\uADFC\uC721 \uC774\uC644 - \uC5B4\uAE68"
    instruction: "\uC5B4\uAE68\uB97C \uC0B4\uC9DD \uC73C\uC4F1\uD588\uB2E4\uAC00\r\n\uCC9C\uCC9C\uD788
      \uB0B4\uB824\uC8FC\uC138\uC694.\r\n\uAE34\uC7A5\uC774 \uC0AC\uB77C\uC9C0\uB294
      \uAC83\uC744 \uB290\uAEF4\uBCF4\uC138\uC694."
    durationSeconds: 6
  - id: 8
    title: "\uB9C8\uC74C \uB3CC\uC544\uBCF4\uAE30"
    instruction: "\uC774 \uC21C\uAC04, \uB2F9\uC2E0\uC740 \uCDA9\uBD84\uD788 \uC798\uD558\uACE0
      \uC788\uC5B4\uC694.\r\n\uC2A4\uC2A4\uB85C\uC5D0\uAC8C \uB530\uB73B\uD55C \uB9D0\uC744
      \uAC74\uB124\uC8FC\uC138\uC694.\r\n\"\uC218\uACE0\uD588\uC5B4, \uC798\uD558\uACE0
      \uC788\uC5B4.\""
    durationSeconds: 7
  - id: 9
    title: "\uC774\uC644 \uC644\uB8CC"
    instruction: "\uCC9C\uCC9C\uD788 \uB208\uC744 \uB728\uACE0,\r\n\uB2E4\uC2DC \uD604\uC2E4\uB85C
      \uB3CC\uC544\uC640\uC8FC\uC138\uC694.\r\n\uC5BC\uB9C8\uB098 \uD3B8\uC548\uD574\uC84C\uB294\uC9C0
      \uB290\uAEF4\uBCF4\uC138\uC694."
    durationSeconds: 6
